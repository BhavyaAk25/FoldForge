# FoldForge works without any key: boxes, pop-up cards, and bird figures are
# designed from parametric templates. Add an AI key to design other objects.
#
# Default provider: Google Gemini (free tier). Get a key at
# https://aistudio.google.com/apikey and paste it below.
AI_API_KEY=

# Optional. Any OpenAI-compatible Chat Completions endpoint works, e.g.
#   Groq (free tier):  AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:        AI_BASE_URL=https://openrouter.ai/api/v1      AI_MODEL=<a ":free" model id>
#   Ollama (local):    AI_BASE_URL=http://localhost:11434/v1         AI_MODEL=qwen2.5:14b   (no key needed)
#   OpenAI (paid):     AI_BASE_URL=https://api.openai.com/v1         AI_MODEL=gpt-4.1-mini
AI_BASE_URL=
AI_MODEL=
